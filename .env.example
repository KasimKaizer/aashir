# Copy this file to .env and replace the placeholders for your provider

# API key used to authenticate requests to the chosen provider
OPENAI_API_KEY=
# Base URL for the provider's OpenAI-compatible API
OPENAI_BASE_URL=
# Name of the model the agent would use
BASE_MODEL_NAME=
# Path to a system prompt file
SYSTEM_PROMPT_FILE=
# Reasoning level to request; choose a value supported by your model and Openai API
REASONING_EFFORT=
